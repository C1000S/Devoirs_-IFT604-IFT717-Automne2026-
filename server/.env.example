# Port d'écoute du serveur HTTP
PORT=3000

# Chaîne de connexion MongoDB
# Avec docker compose (voir docker-compose.yml à la racine du dépôt) :
MONGODB_URI=mongodb://127.0.0.1:27017/repare-campus

# Secret utilisé pour signer les JSON Web Tokens.
# IMPORTANT : en production, utilisez une valeur longue et aléatoire, et ne la déposez JAMAIS dans Git.
JWT_SECRET=dev-secret-a-remplacer-en-production
JWT_EXPIRES_IN=7d

# Nombre de tours bcrypt pour le hachage des mots de passe
BCRYPT_ROUNDS=10

# Expression cron de la tâche nocturne (par défaut : chaque soir à 23 h 00)
NIGHTLY_CRON=0 23 * * *
NIGHTLY_TIMEZONE=America/Toronto

# Active la route de déclenchement manuel du traitement nocturne et le seed (mode démonstration)
DEMO_MODE=true

# Origines autorisées pour CORS (séparées par des virgules), * pour tout autoriser
CORS_ORIGIN=*
